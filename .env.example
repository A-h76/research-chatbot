# ─── Core ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
FLASK_SECRET_KEY=change-me-to-a-long-random-string
# Required in production (FLASK_ENV/APP_ENV=production). Never leave blank
# in production — the app refuses to start rather than invent a random key.
# Optional override for JWTs; defaults to FLASK_SECRET_KEY when unset.
# JWT_SECRET_KEY=
# SQLite (default for local dev) or PostgreSQL for production
DATABASE_URL=sqlite:///chat_dev.db
# Either FLASK_ENV or APP_ENV (below) set to "production" enables Secure
# cookies — redundant on purpose, server.py checks both.
FLASK_ENV=development

# Phase A: normal chat uses PromptBuilder.build_chat_instructions() when true
# (default). Set false only for emergency rollback to the legacy assembler.
CHAT_USE_PROMPT_BUILDER=true

# Paper Chat Stage 1 (ai_core pipeline). Default false = legacy path only.
# shadow = build pipeline PromptPlan + log prompt-hash parity; still serve legacy stream.
# true  = serve via PromptRouter + AIExecutor Responses stream (behaviour-identical).
# Soak order: shadow (staging) → true (staging) → allowlist → broad. Do not start Stage 2 until tagged.
# PAPER_CHAT_PIPELINE_ENABLED=false

# ─── Auth (Google OAuth) ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated allow-list of emails (blank = anyone with a Google account)
ALLOWED_EMAILS=

# ─── DEV BYPASS (local development only) ─────────────────────────────────────
# Set this to any non-empty value to skip Google OAuth entirely.
# Visiting /login will automatically sign you in as dev@localhost.
# DELETE THIS LINE (or leave blank) before deploying to production.
DEV_AUTO_LOGIN=1

# ─── Models ──────────────────────────────────────────────────────────────────
DEFAULT_MODEL=gpt-4o-mini
UTILITY_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
MODELS=gpt-4o,gpt-4o-mini,gpt-4-turbo

# ─── Uploads (Cloudflare R2 — S3-compatible object storage) ──────────────────
MAX_FILE_MB=25
# Per-user total storage quota is User.storage_limit_bytes (DB column,
# defaults to QuotaService.DEFAULT_STORAGE_LIMIT_BYTES, ~1000 MB) — not an
# env var. Both /api/files and /api/documents/upload check against it.
# Max size for a single POST /api/documents/upload request, in MB.
MAX_DOCUMENT_UPLOAD_MB=50
# PR3: uploads are sniffed (magic bytes) against the filename extension.
# Optional ClamAV — disabled by default (fail-open). When enabled, fail-closed
# if clamd is unreachable; infected files are quarantined under
# CLAMAV_QUARANTINE_DIR (default: uploads/quarantine).
# CLAMAV_ENABLED=0
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_SOCKET=
# CLAMAV_QUARANTINE_DIR=
# CLAMAV_TIMEOUT=10
R2_BUCKET=research-space
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# backend/storage's own provider choice (r2 | local | s3). Leave blank to
# auto-pick r2 when R2_BUCKET above is set, local otherwise.
STORAGE_BACKEND=

# ─── Queue worker (worker.py) ─────────────────────────────────────────────────
# How often (seconds) the worker polls upload_jobs for new work.
WORKER_POLL_INTERVAL=2
# Max jobs claimed per poll.
WORKER_BATCH_SIZE=10
# Attempts before a job is dead-lettered (marked failed for good).
WORKER_MAX_ATTEMPTS=5
# How stale worker.py's heartbeat can be before GET /api/worker/health
# reports "down" (read by server.py, not worker.py).
WORKER_HEALTH_THRESHOLD_SECONDS=60
# Port worker.py serves its own Prometheus /metrics on (separate process
# from server.py, so it needs its own exposition endpoint — see
# observability/metrics.py). Bound to loopback by default (PR2).
WORKER_METRICS_PORT=9101
WORKER_METRICS_BIND=127.0.0.1

# ─── Prometheus /metrics (Flask) ─────────────────────────────────────────────
# When set, GET /metrics requires Authorization: Bearer <token>.
# When unset, only loopback clients (127.0.0.1 / ::1) are allowed.
# Set METRICS_ALLOW_UNAUTHENTICATED=1 only for local open scrapes (never prod).
METRICS_TOKEN=
# METRICS_ALLOW_UNAUTHENTICATED=

# ─── Job-status cache + rate-limit store (optional in dev) ───────────────────
# Never the source of truth for jobs (Postgres upload_jobs always is).
# When set and reachable, Flask-Limiter also uses Redis so limits are shared
# across workers. Leave blank for in-process memory:// limits (dev / single worker).
# In production, if REDIS_URL is set but unreachable, startup fails closed.
REDIS_URL=

# ─── Email (Resend — optional) ───────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Research Workspace <onboarding@resend.dev>
SUPPORT_EMAIL=
APP_BASE_URL=http://localhost:5000

# ─── Scholarly provider integrations ────────────────────────────────────────
# Crossref (no key required — mailto is used for polite pool access)
CROSSREF_MAILTO=admin@soro.app
# Optional Crossref Plus paid-tier token (leave empty for free tier)
CROSSREF_PLUS_TOKEN=

# OpenAlex (no key required for standard use; add key for higher rate limits)
OPENALEX_API_KEY=

# Semantic Scholar — API key required for /recommendations endpoint
# Request at: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# ─── Environment ─────────────────────────────────────────────────────────────
# Set to "production" to enable Secure cookies (requires HTTPS)
APP_ENV=development

# ─── Session TTL (PR4) ───────────────────────────────────────────────────────
# Idle: expire after N minutes without activity (0 = disable idle check).
SESSION_IDLE_MINUTES=60
# Absolute: expire N hours after login regardless of activity (0 = disable).
SESSION_ABSOLUTE_HOURS=12
# CSP Report-Only: on automatically in production. Force in dev with:
# CSP_REPORT_ONLY=1
# Disable entirely with CSP_REPORT_ONLY_DISABLE=1
# Optional override policy:
# CSP_REPORT_ONLY_POLICY=
