# ─── Core ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
FLASK_SECRET_KEY=change-me-to-a-long-random-string
# Required in production (FLASK_ENV/APP_ENV=production). Never leave blank
# in production — the app refuses to start rather than invent a random key.
# Optional override for JWTs; defaults to FLASK_SECRET_KEY when unset.
# JWT_SECRET_KEY=
# SQLite (default for local dev) or PostgreSQL for production
DATABASE_URL=sqlite:///chat_dev.db
# Either FLASK_ENV or APP_ENV (below) set to "production" enables Secure
# cookies — redundant on purpose, server.py checks both.
FLASK_ENV=development

# Phase A: normal chat uses PromptBuilder.build_chat_instructions() when true
# (default). Set false only for emergency rollback to the legacy assembler.
CHAT_USE_PROMPT_BUILDER=true

# Paper chat system prompt via PromptBuilder.build_paper_chat_instructions()
# (default true — same M7 legacy text). Set false to call render directly.
PAPER_CHAT_USE_PROMPT_BUILDER=true
# Inject persisted Phase 1 analysis as a developer message in paper chat
# (does not replace RAG excerpts). Set false to disable.
PAPER_CHAT_PHASE1_CONTEXT=true

# Paper Chat Stage 1 (ai_core pipeline). Default false = legacy path only.
# shadow = build pipeline PromptPlan + log prompt-hash parity; still serve legacy stream.
# true  = serve via PromptRouter + AIExecutor Responses stream (behaviour-identical).
# Soak order: shadow (staging) → true (staging) → allowlist → broad. Do not start Stage 2 until tagged.
# PAPER_CHAT_PIPELINE_ENABLED=false

# ─── Auth (Google OAuth) ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated allow-list of emails (blank = open signup in local/dev).
# Production REQUIRES ALLOWED_EMAILS or BETA_INVITE_ONLY=1 (closed beta gate).
ALLOWED_EMAILS=
# BETA_INVITE_ONLY=1
# Closed beta: same effect as BETA_INVITE_ONLY but controlled by a separate flag.
# CLOSED_BETA=
# Concurrent project-research jobs per user (default 5 for multi-user closed beta).
# MAX_ACTIVE_RESEARCH=5
# DB pool sized for ~5 researchers online together.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# Admin AI kill switch + daily budget: PATCH /api/admin/ops/settings
# { "ai_disabled": true, "daily_ai_budget_usd": 10 }

# ─── DEV BYPASS (local development only) ─────────────────────────────────────
# Set this to any non-empty value to skip Google OAuth entirely.
# Visiting /login will automatically sign you in as dev@localhost.
# DELETE THIS LINE (or leave blank) before deploying to any shared host.
# Production boot refuses DEV_AUTO_LOGIN when FLASK_ENV/APP_ENV=production;
# /api/dev-login also requires a non-production environment (Phase 2).
DEV_AUTO_LOGIN=

# ─── AI Models (AI Gateway v1.0 — governed by docs/AI_POLICY_v1.0.md) ────────
# Allowed models in OpenAI project (verified 2026-07-29):
#   gpt-5-mini, gpt-5.5, gpt-5.5-pro, text-embedding-3-small,
#   gpt-4o-mini-search-preview, omni-moderation-latest
#
# DEFAULT_MODEL / UTILITY_MODEL are used by legacy paths and backfill.py.
# The AI Gateway (backend/ai/gateway.py) resolves models via
# docs/AI_MODEL_REGISTRY.yaml + backend/ai/policy.yaml — not these vars.
# Keep these aligned with the registry's fast tier to avoid surprises.
DEFAULT_MODEL=gpt-5-mini
UTILITY_MODEL=gpt-5-mini
EMBED_MODEL=text-embedding-3-small
# Legacy MODELS list (used by UI model selector if enabled). Keep in sync
# with OpenAI project allowlist above.
MODELS=gpt-5.5,gpt-5-mini,gpt-5.5-pro

# ── AI Gateway confidence routing thresholds ─────────────────────────────────
# Confidence >= HIGH → route to fast tier regardless of requested mode.
# Confidence < LOW   → escalate to publication tier.
# Defaults are fine for v0.2.x; tune after telemetry evidence.
# AI_GATEWAY_CONFIDENCE_HIGH=0.95
# AI_GATEWAY_CONFIDENCE_LOW=0.70

# ── Default quality mode for worker background tasks ─────────────────────────
# fast | balanced | publication  (default: balanced)
# AI_QUALITY_MODE=balanced

# ── Future provider keys (not used in v0.2.x — gateway routes OpenAI only) ───
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ─── Uploads (Cloudflare R2 — S3-compatible object storage) ──────────────────
MAX_FILE_MB=25
# Per-user total storage quota is User.storage_limit_bytes (DB column,
# defaults to QuotaService.DEFAULT_STORAGE_LIMIT_BYTES, ~1000 MB) — not an
# env var. Both /api/files and /api/documents/upload check against it.
# Max size for a single POST /api/documents/upload request, in MB.
MAX_DOCUMENT_UPLOAD_MB=50
# Max documents per bulk upload batch (backend/upload/bulk.py).
# MAX_BATCH_SIZE=10
# Local upload directory (used when STORAGE_BACKEND=local).
# UPLOAD_DIR=uploads
# PR3: uploads are sniffed (magic bytes) against the filename extension.
# ClamAV — when enabled, fail-closed if clamd is unreachable; infected files
# are quarantined under CLAMAV_QUARANTINE_DIR (default: uploads/quarantine).
# Production (Phase 4): CLAMAV_ENABLED=1 is required unless you explicitly
# acknowledge risk with CLAMAV_OPTIONAL=1.
# CLAMAV_ENABLED=1
# CLAMAV_OPTIONAL=0
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_SOCKET=
# CLAMAV_QUARANTINE_DIR=
# CLAMAV_TIMEOUT=10
R2_BUCKET=research-space
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# backend/storage's own provider choice (r2 | local | s3). Leave blank to
# auto-pick r2 when R2_BUCKET above is set, local otherwise.
STORAGE_BACKEND=

# ─── Queue worker (worker.py) ─────────────────────────────────────────────────
# How often (seconds) the worker polls upload_jobs for new work.
WORKER_POLL_INTERVAL=2
# Max jobs claimed per poll.
WORKER_BATCH_SIZE=10
# Attempts before a job is dead-lettered (marked failed for good).
WORKER_MAX_ATTEMPTS=5
# How stale worker.py's heartbeat can be before GET /api/worker/health
# reports "down" (read by server.py, not worker.py).
WORKER_HEALTH_THRESHOLD_SECONDS=60
# Port worker.py serves its own Prometheus /metrics on (separate process
# from server.py, so it needs its own exposition endpoint — see
# observability/metrics.py). Bound to loopback by default (PR2).
WORKER_METRICS_PORT=9101
WORKER_METRICS_BIND=127.0.0.1

# ─── Prometheus /metrics (Flask) ─────────────────────────────────────────────
# When set, GET /metrics requires Authorization: Bearer <token>.
# When unset, only loopback clients (127.0.0.1 / ::1) are allowed.
# Set METRICS_ALLOW_UNAUTHENTICATED=1 only for local open scrapes (never prod).
METRICS_TOKEN=
# METRICS_ALLOW_UNAUTHENTICATED=

# ─── Job-status cache + rate-limit store (optional in dev) ───────────────────
# Never the source of truth for jobs (Postgres upload_jobs always is).
# When set and reachable, Flask-Limiter also uses Redis so limits are shared
# across workers. Leave blank for in-process memory:// limits (dev / single worker).
# In production, if REDIS_URL is set but unreachable, startup fails closed.
REDIS_URL=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Leave RESEND_API_KEY blank in local dev to log emails to the console.
# Production: verify dhund.com in Resend, then use noreply@dhund.com.
RESEND_API_KEY=
EMAIL_FROM=Dhund <noreply@dhund.com>
SUPPORT_EMAIL=support@dhund.com
APP_BASE_URL=https://app.dhund.com

# ─── Scholarly provider integrations ─────────────────────────────────────────
# Crossref (no key required — mailto is used for polite pool access)
CROSSREF_MAILTO=admin@dhund.app
# Optional Crossref Plus paid-tier token (leave empty for free tier)
CROSSREF_PLUS_TOKEN=
# Request timeout in seconds for Crossref API calls (default 5).
# CROSSREF_TIMEOUT=5

# OpenAlex — no API key required for normal use.
# Override base URL only if you proxy or use a mirror.
OPENALEX_BASE_URL=https://api.openalex.org

# Semantic Scholar — API key required for /recommendations endpoint.
# Request at: https://www.semanticscholar.org/product/api
# Also accepted as S2_API_KEY (legacy alias).
SEMANTIC_SCHOLAR_API_KEY=
# Request timeout in seconds for Semantic Scholar API calls (default 5).
# S2_TIMEOUT=5

# Per-provider kill switches (default true). Disable independently under load.
ENABLE_CROSSREF=true
ENABLE_OPENALEX=true
ENABLE_SEMANTIC_SCHOLAR=true

# Resilience knobs — circuit breaker + bulkhead concurrency limits.
# Defaults are safe for ~100 concurrent users; tune after load testing.
# PROVIDER_CIRCUIT_FAILURES=5
# PROVIDER_CIRCUIT_OPEN_SECONDS=300
# PROVIDER_BULKHEAD_WAIT=0.15
# PROVIDER_BULKHEAD_CROSSREF=2
# PROVIDER_BULKHEAD_OPENALEX=2
# PROVIDER_BULKHEAD_SEMANTIC_SCHOLAR=2

# ─── Library Bridge ───────────────────────────────────────────────────────────
# Zotero OAuth 1.0a — https://www.zotero.org/oauth/apps
# Callbacks must match APP_BASE_URL + /api/library/zotero/callback
ZOTERO_CLIENT_KEY=
ZOTERO_CLIENT_SECRET=

# Mendeley OAuth 2.0 — https://dev.mendeley.com/
# Callbacks must match APP_BASE_URL + /api/library/mendeley/callback
MENDELEY_CLIENT_ID=
MENDELEY_CLIENT_SECRET=

# ─── Environment ─────────────────────────────────────────────────────────────
# Set to "production" to enable Secure cookies (requires HTTPS).
APP_ENV=development

# ─── Session TTL (PR4) ───────────────────────────────────────────────────────
# Idle: expire after N minutes without activity (0 = disable idle check).
SESSION_IDLE_MINUTES=60
# Absolute: expire N hours after login regardless of activity (0 = disable).
SESSION_ABSOLUTE_HOURS=12

# ─── Content Security Policy ──────────────────────────────────────────────────
# Production (Phase 4): CSP is enforced by default (Content-Security-Policy).
# Rollback to Report-Only if a deploy breaks the SPA:
# CSP_REPORT_ONLY=1
# Disable CSP entirely:
# CSP_DISABLE=1
# (alias) CSP_REPORT_ONLY_DISABLE=1
# Dev: force Report-Only or enforce with CSP_REPORT_ONLY=1 / CSP_ENFORCE=1
# Optional override policy (full CSP string):
# CSP_POLICY=
# CSP_REPORT_ONLY_POLICY=
